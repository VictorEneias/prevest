---
/** Base das camadas. No MDX use os wrappers, não este. */
interface Props {
  camada: 'dica' | 'resolucao' | 'pensamento' | 'erros' | 'curiosidade';
  rotulo: string;
  /** Modos em que a camada nasce aberta. */
  abertaEm?: string[];
}
const { camada, rotulo, abertaEm = ['estudo'] } = Astro.props;
---
<details class="camada" data-camada={camada} data-aberta-em={abertaEm.join(' ')}>
  <summary>{rotulo}</summary>
  <div class="camada-corpo"><slot /></div>
</details>
