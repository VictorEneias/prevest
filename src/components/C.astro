---
/**
 * <C id="potenciacao">potenciação</C>
 *
 * Abre painel por cima em vez de navegar, porque trocar de página no meio da
 * explicação faz o aluno perder o fio. Os painéis empilham, então dá pra descer
 * até onde estiver o buraco e voltar fechando um por um.
 *
 * Id que não existe não quebra o build aqui, quem quebra é o npm run grafo,
 * mas o elo já aparece vermelho na página.
 */
import { getCollection } from 'astro:content';

interface Props {
  id: string;
}
const { id } = Astro.props;

const todos = await getCollection('conceitos');
const alvo = todos.find((c) => c.id === id);
---

<button
  type="button"
  class="elo-conceito"
  data-conceito={id}
  data-quebrado={alvo ? 'nao' : 'sim'}
  title={alvo ? `Abrir: ${alvo.data.titulo}` : `CONCEITO INEXISTENTE: ${id}`}
  aria-label={alvo ? `Abrir pré-requisito: ${alvo.data.titulo}` : `Link quebrado: ${id}`}
>
  <slot />
</button>
