---
/**
 * <C id="potenciacao">potenciação</C>
 *
 * NÃO navega. Abre um painel por cima, e os painéis empilham.
 * Motivo: no meio de uma explicação, trocar de página faz o aluno perder o fio.
 * Com painel, você desce até onde o buraco estiver e volta fechando um por um.
 *
 * Se o id não existir na collection, o build NÃO quebra aqui (o script
 * scripts/checar-grafo.mjs é quem quebra), mas o elo aparece marcado em
 * vermelho — você vê o link morto na hora, na própria página.
 */
import { getCollection } from 'astro:content';

interface Props {
  id: string;
}
const { id } = Astro.props;

const todos = await getCollection('conceitos');
const alvo = todos.find((c) => c.id === id);
---

<button
  type="button"
  class="elo-conceito"
  data-conceito={id}
  data-quebrado={alvo ? 'nao' : 'sim'}
  title={alvo ? `Abrir: ${alvo.data.titulo}` : `CONCEITO INEXISTENTE: ${id}`}
  aria-label={alvo ? `Abrir pré-requisito: ${alvo.data.titulo}` : `Link quebrado: ${id}`}
>
  <slot />
</button>
