---
/**
 * Ponte do MDX pro React.
 *
 * O Astro só hidrata uma ilha React se a diretiva client:* estiver num arquivo
 * que ele analisa estaticamente, e componente injetado por `components={...}`
 * no MDX não passa por essa análise. Então a diretiva mora aqui e o MDX escreve
 * <Juncao parcelas={[7,-3]} /> limpo, sem import.
 *
 * Todo interativo novo precisa de um wrapper igual a este.
 */
import JuncaoReact from './Juncao.tsx';
import type { JuncaoProps } from './Juncao.tsx';

const props = Astro.props as JuncaoProps;
---
<JuncaoReact client:visible {...props} />
