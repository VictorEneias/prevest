---
/**
 * <Questao /> — questão de múltipla escolha com correção na hora.
 *
 * O aluno clica numa alternativa: acertou fica verde, errou fica vermelho (e a
 * correta é apontada). Nos dois casos o gabarito passo a passo abre embaixo.
 *
 * POR QUE ASTRO PURO E NÃO REACT (a seção 6 do CLAUDE.md pede React + wrapper):
 * o enunciado, as alternativas e o gabarito precisam de LaTeX, e o LaTeX só é
 * processado pelo KaTeX quando o conteúdo passa pelo pipeline do MDX. Prop de
 * string entregue a uma ilha React não passa — sairia "$-3$" cru na tela. Aqui a
 * interação é ligar/desligar classe, então ~40 linhas de script valem mais que
 * hidratar React. Componente que DESENHA e reage a arrasto continua sendo React.
 *
 * O gabarito respeita o portão de revisão: some no Modo Aula enquanto a página
 * for `revisado: false`, igual às camadas. Em Modo Prova some sempre.
 */
import katex from 'katex';

interface Props {
  /** Número mostrado no cabeçalho. */
  n?: number;
  /**
   * De 2 a 5 alternativas, na ordem a→e. Trechos entre $...$ viram LaTeX;
   * o resto é texto. Ex.: ["$-3$", "$3$", "Nenhuma das anteriores"]
   */
  alternativas: string[];
  /** Letra da correta: "a".."e". Errar aqui quebra o build de propósito. */
  correta: string;
  /** "FUVEST 2019 — Q42" ou "Autoral". Opcional. */
  fonte?: string;
}
const { n, alternativas, correta, fonte } = Astro.props;

const LETRAS = ['a', 'b', 'c', 'd', 'e'] as const;

/* Validação no build: melhor quebrar aqui do que servir gabarito errado em aula. */
if (!Array.isArray(alternativas) || alternativas.length < 2) {
  throw new Error('<Questao>: precisa de ao menos 2 alternativas.');
}
if (alternativas.length > LETRAS.length) {
  throw new Error(`<Questao>: no máximo ${LETRAS.length} alternativas (a–e).`);
}
const iCorreta = LETRAS.indexOf(String(correta).trim().toLowerCase() as (typeof LETRAS)[number]);
if (iCorreta < 0 || iCorreta >= alternativas.length) {
  throw new Error(
    `<Questao>: correta="${correta}" não existe. ` +
      `Use uma letra entre "a" e "${LETRAS[alternativas.length - 1]}".`,
  );
}
const letraCorreta = LETRAS[iCorreta];

const escapar = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

/** Renderiza os trechos entre $...$ com KaTeX e escapa o resto. */
const comMatematica = (bruto: string) =>
  String(bruto)
    .split(/(\$[^$]*\$)/g)
    .map((seg) =>
      seg.length > 2 && seg.startsWith('$') && seg.endsWith('$')
        ? katex.renderToString(seg.slice(1, -1), { throwOnError: false, strict: false })
        : escapar(seg),
    )
    .join('');
---

<section class="questao" data-correta={letraCorreta}>
  <header class="questao-topo">
    <span class="questao-n">{n ? `Questão ${n}` : 'Questão'}</span>
    {fonte && <span class="questao-fonte">{fonte}</span>}
  </header>

  <div class="questao-enunciado"><slot /></div>

  <ol class="alternativas">
    {
      alternativas.map((alt, i) => (
        <li>
          <button type="button" class="alt" data-letra={LETRAS[i]} aria-pressed="false">
            <span class="alt-letra" aria-hidden="true">{LETRAS[i]}</span>
            <span class="alt-texto" set:html={comMatematica(alt)} />
            <span class="alt-marca" aria-hidden="true" />
          </button>
        </li>
      ))
    }
  </ol>

  <p class="questao-veredito" role="status" aria-live="polite"></p>

  <div class="questao-gabarito" hidden>
    <div class="gabarito-topo">
      <span class="gabarito-rotulo">Resolução</span>
      <button type="button" class="questao-refazer">responder de novo</button>
    </div>
    <slot name="gabarito" />
  </div>
</section>

<script>
  /* Delegação: um listener cobre todas as questões da página (e do fragmento
     dentro do iframe do painel, que carrega este mesmo componente). */
  const LETRAS_ARIA: Record<string, string> = {
    a: 'A', b: 'B', c: 'C', d: 'D', e: 'E',
  };

  function responder(btn: HTMLElement) {
    const q = btn.closest<HTMLElement>('.questao');
    if (!q || q.dataset.respondida === 'sim') return;

    const escolhida = btn.dataset.letra!;
    const correta = q.dataset.correta!;
    const acertou = escolhida === correta;

    q.dataset.respondida = 'sim';
    q.dataset.resultado = acertou ? 'certo' : 'errado';
    btn.dataset.estado = acertou ? 'certo' : 'errado';
    btn.setAttribute('aria-pressed', 'true');

    if (!acertou) {
      const certa = q.querySelector<HTMLElement>(`.alt[data-letra="${correta}"]`);
      if (certa) certa.dataset.estado = 'era-esta';
    }

    /* Não uso disabled: o botão sairia da ordem de tabulação e o aluno de
       teclado perderia a leitura das outras alternativas. */
    q.querySelectorAll<HTMLElement>('.alt').forEach((b) => {
      b.dataset.travado = 'sim';
    });

    const veredito = q.querySelector<HTMLElement>('.questao-veredito');
    if (veredito) {
      veredito.textContent = acertou
        ? '✓ Isso aí. A resolução está aqui embaixo.'
        : `✗ Não é essa — a resposta é ${LETRAS_ARIA[correta] ?? correta.toUpperCase()}. Acompanha a resolução.`;
    }

    const gabarito = q.querySelector<HTMLElement>('.questao-gabarito');
    if (gabarito) gabarito.hidden = false;
  }

  function limpar(q: HTMLElement) {
    delete q.dataset.respondida;
    delete q.dataset.resultado;
    q.querySelectorAll<HTMLElement>('.alt').forEach((b) => {
      delete b.dataset.estado;
      delete b.dataset.travado;
      b.setAttribute('aria-pressed', 'false');
    });
    const veredito = q.querySelector<HTMLElement>('.questao-veredito');
    if (veredito) veredito.textContent = '';
    const gabarito = q.querySelector<HTMLElement>('.questao-gabarito');
    if (gabarito) gabarito.hidden = true;
    q.querySelector<HTMLElement>('.alt')?.focus();
  }

  document.addEventListener('click', (ev) => {
    const alvo = ev.target as HTMLElement | null;
    if (!alvo?.closest) return;

    const alt = alvo.closest<HTMLElement>('.alt');
    if (alt) {
      responder(alt);
      return;
    }
    const refazer = alvo.closest<HTMLElement>('.questao-refazer');
    if (refazer) {
      const q = refazer.closest<HTMLElement>('.questao');
      if (q) limpar(q);
    }
  });
</script>
