---
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  titulo: string;
  fragmento?: boolean;
}
const { titulo, fragmento = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR" data-modo="estudo" data-tamanho="normal">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="color-scheme" content="light" />
  </head>
  <body class={fragmento ? 'fragmento' : ''}>
    <a class="pular" href="#conteudo">Pular pro conteúdo</a>

    {
      !fragmento && (
        <header class="topo">
          <a href={`${base}/`} class="marca">Pré-vestibular</a>
          <span class="espaco" />
          <div class="barra-modo" role="group" aria-label="Modo de exibição">
            <button data-modo-btn="estudo" aria-pressed="true">Estudo</button>
            <button data-modo-btn="aula" aria-pressed="false">Aula</button>
          </div>
          <button class="painel-botao" data-zoom title="Tamanho da fonte (Alt+Z)">A↕</button>
        </header>
      )
    }

    <main id="conteudo">
      <slot />
    </main>

    {
      !fragmento && (
        <>
          <div class="pilha-fundo" data-pilha-fundo data-aberto="nao" />
          <div data-pilha />
        </>
      )
    }

    <script is:inline define:vars={{ base }}>
      (() => {
        const html = document.documentElement;

        /* Cada camada declara em que modos nasce aberta. Trocar o modo só
           abre e fecha <details>, então dá pra reabrir no clique em aula. */
        const MODOS = {
          estudo: ['resolucao', 'pensamento', 'erros'],
          aula: [],
        };

        function aplicarModo(modo) {
          html.dataset.modo = modo;
          try { localStorage.setItem('modo', modo); } catch (e) {}
          document.querySelectorAll('[data-modo-btn]').forEach((b) => {
            b.setAttribute('aria-pressed', String(b.dataset.modoBtn === modo));
          });
          const abertas = MODOS[modo] || [];
          document.querySelectorAll('.camada').forEach((d) => {
            d.open = abertas.includes(d.dataset.camada);
          });
        }

        document.querySelectorAll('[data-modo-btn]').forEach((b) => {
          b.addEventListener('click', () => aplicarModo(b.dataset.modoBtn));
        });

        const TAMANHOS = ['normal', 'grande', 'enorme'];
        function girarZoom() {
          const i = TAMANHOS.indexOf(html.dataset.tamanho || 'normal');
          const novo = TAMANHOS[(i + 1) % TAMANHOS.length];
          html.dataset.tamanho = novo;
          try { localStorage.setItem('tamanho', novo); } catch (e) {}
        }
        document.querySelector('[data-zoom]')?.addEventListener('click', girarZoom);

        try {
          aplicarModo(localStorage.getItem('modo') || 'estudo');
          html.dataset.tamanho = localStorage.getItem('tamanho') || 'normal';
        } catch (e) {
          aplicarModo('estudo');
        }

        /* Pilha de painéis. Uso iframe pra o fragmento carregar inteiro, com
           CSS, KaTeX e as ilhas React hidratando: assim o painel do
           pré-requisito tem o gráfico interativo dele. */
        const fundo = document.querySelector('[data-pilha-fundo]');
        const raiz = document.querySelector('[data-pilha]');
        const pilha = [];

        function desenharTrilha() {
          pilha.forEach((p, i) => {
            const trilha = p.el.querySelector('.painel-trilha');
            const caminho = pilha.slice(0, i + 1).map((q, k) =>
              k === i ? `<b>${q.titulo}</b>` : q.titulo
            );
            trilha.innerHTML = 'Você está em: ' + caminho.join(' › ');
          });
        }

        function abrir(id, titulo) {
          const el = document.createElement('aside');
          el.className = 'painel';
          el.setAttribute('role', 'dialog');
          el.setAttribute('aria-label', titulo || id);
          el.style.zIndex = String(51 + pilha.length);
          el.style.right = `${Math.min(pilha.length, 4) * 14}px`;
          el.innerHTML =
            '<div class="painel-topo">' +
            '<span class="painel-trilha"></span>' +
            `<a class="painel-botao" href="${base}/conceitos/${id}/" target="_top">Abrir inteiro</a>` +
            '<button class="painel-botao" data-fechar>Fechar ✕</button>' +
            '</div>' +
            `<iframe src="${base}/fragmento/${id}/" title="${titulo || id}"></iframe>`;
          el.querySelector('[data-fechar]').addEventListener('click', fechar);
          raiz.appendChild(el);
          pilha.push({ id, titulo: titulo || id, el });
          fundo.dataset.aberto = 'sim';
          desenharTrilha();
        }

        function fechar() {
          const p = pilha.pop();
          if (p) p.el.remove();
          if (!pilha.length) fundo.dataset.aberto = 'nao';
          desenharTrilha();
        }

        function fecharTudo() {
          while (pilha.length) fechar();
        }

        fundo?.addEventListener('click', fecharTudo);

        document.addEventListener('click', (e) => {
          const alvo = e.target.closest('[data-conceito]');
          if (!alvo) return;
          if (alvo.dataset.quebrado === 'sim') {
            alert(`Conceito "${alvo.dataset.conceito}" ainda não existe. Rode: npm run grafo`);
            return;
          }
          abrir(alvo.dataset.conceito, alvo.textContent.trim());
        });

        /* Clique de <C> dentro de um painel: o iframe avisa o pai. */
        window.addEventListener('message', (e) => {
          if (e.data?.tipo === 'abrir-conceito') abrir(e.data.id, e.data.titulo);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && pilha.length) { fechar(); return; }
          if (!e.altKey) return;
          const mapa = { '1': 'estudo', '2': 'aula' };
          if (mapa[e.key]) { e.preventDefault(); aplicarModo(mapa[e.key]); }
          if (e.key.toLowerCase() === 'z') { e.preventDefault(); girarZoom(); }
        });
      })();
    </script>
  </body>
</html>
