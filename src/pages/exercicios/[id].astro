---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { componentesMDX } from '../../components/mdx';

export async function getStaticPaths() {
  const todos = await getCollection('exercicios');
  return todos.map((e) => ({ params: { id: e.id }, props: { e } }));
}

const { e } = Astro.props;
const { Content } = await render(e);
const d = e.data;
const NIVEL = { A: 'Nível A — mecânica', B: 'Nível B — vestibular', C: 'Nível C — integração' };
---
<BaseLayout titulo={`${d.fonte} — Pré-vestibular`}>
  <div class="folha">
    <article class={`papel ${d.revisado ? '' : 'conceito-nao-revisado'}`}>
      {!d.revisado && (
        <div class="rascunho">
          <b>Rascunho — não revisado</b>
          Resolução não conferida. Refaça a conta antes de mostrar pro aluno.
        </div>
      )}
      <div class="ficha">
        <span><b>{d.fonte}</b></span>
        <span>{NIVEL[d.nivel]}</span>
        {d.tempo_alvo && <span>alvo: {d.tempo_alvo} min</span>}
      </div>
      <hr class="regua" />
      <Content components={componentesMDX} />
    </article>
  </div>
</BaseLayout>
