---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { componentesMDX } from '../../components/mdx';
import MapaConceitos from '../../components/viz/MapaConceitos.astro';
import { ROTULO_MATERIA, rotuloBloco } from '../../lib/curriculo';
import { dependemDe } from '../../lib/grafo';

export async function getStaticPaths() {
  const todos = await getCollection('conceitos');
  const mapa = new Map(todos.map((c) => [c.id, c]));
  return todos.map((c) => ({ params: { id: c.id }, props: { c, mapa } }));
}

const { c, mapa } = Astro.props;
const { Content } = await render(c);
const d = c.data;
const filhos = await dependemDe(c.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const NIVEL = { fundamento: 'Fundamento', basico: 'Básico', medio: 'Médio', avancado: 'Avançado' };
---
<BaseLayout titulo={`${d.titulo} — Pré-vestibular`}>
  <div class="folha">
    <article class={`papel ${d.revisado ? '' : 'conceito-nao-revisado'}`}>
      {!d.revisado && (
        <div class="rascunho">
          <b>Rascunho — não revisado</b>
          Nada aqui foi conferido linha por linha ainda, e o erro que aparece nesse
          estágio é o sutil: sinal trocado numa passagem, condição de existência
          omitida, caso particular tratado como geral. Confira antes de usar em aula
          e mude <code>revisado: true</code> no frontmatter.
        </div>
      )}

      <h1>{d.titulo}</h1>
      {d.subtitulo && <p style="color:var(--tinta-media);margin-top:calc(var(--u)*-0.5)">{d.subtitulo}</p>}

      <div class="ficha">
        <span><b>{ROTULO_MATERIA[d.materia]}</b> · {rotuloBloco(d.bloco)}</span>
        <span>{NIVEL[d.nivel]}</span>
        {d.tempo_estimado && <span>~{d.tempo_estimado} min</span>}
        {d.itens_fuvest !== undefined && <span><b>{d.itens_fuvest}</b> itens FUVEST</span>}
      </div>

      {d.prereqs.length > 0 && (
        <>
          <p style="font-family:var(--f-ui);font-size:.74rem;text-transform:uppercase;letter-spacing:.07em;color:var(--tinta-fraca);margin-bottom:6px">
            Precisa saber antes
          </p>
          <ul class="prereq-lista">
            {d.prereqs.map((p) => (
              <li>
                <button class="elo-conceito" data-conceito={p} data-quebrado={mapa.has(p) ? 'nao' : 'sim'}>
                  {mapa.get(p)?.data.titulo ?? p}
                </button>
              </li>
            ))}
          </ul>
        </>
      )}

      <hr class="regua" />
      <Content components={componentesMDX} />

      {(filhos.length > 0 || d.prereqs.length > 0) && (
        <>
          <hr class="regua" />
          <p style="font-family:var(--f-ui);font-size:.74rem;text-transform:uppercase;letter-spacing:.07em;color:var(--tinta-fraca);margin-bottom:6px">
            Onde este módulo se encaixa
          </p>
          <p style="font-family:var(--f-ui);font-size:.8rem;color:var(--tinta-media);margin-bottom:calc(var(--u)*0.5)">
            Nada aqui está bloqueado. É só o que se conecta a este módulo — o que
            vem antes, à esquerda, e o que continua a partir dele, à direita.
          </p>
          <MapaConceitos foco={c.id} raio={1} altura="34vh" />
        </>
      )}
    </article>
  </div>
</BaseLayout>
